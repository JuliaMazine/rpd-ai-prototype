DATABASE_URL=postgresql+psycopg2://rpd_user:rpd_password@localhost:5432/rpd_ai
# Set a persistent random value to keep login sessions across restarts.
SESSION_SECRET=
SEED_DEMO_DATA=false
SECURE_COOKIES=false
VSEGPT_API_KEY=
VSEGPT_MODEL=
VSEGPT_BASE_URL=https://api.vsegpt.ru/v1

# Local generation. Download the model with: ollama pull qwen3:4b
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_CONTEXT_LENGTH=16384
LLM_TIMEOUT_SECONDS=600
LLM_MAX_TOKENS=4500
# Other providers: vsegpt (uses VSEGPT_* above), template (no AI requests).
# Upload limit in MiB; allowed range 1–100.
MAX_UPLOAD_MB=25
# Optional local folder with reference RPDs; files are used only for style.
RPD_EXAMPLES_DIR=references/rpd_examples
